# Local development only. Production should inject variables through its secret store.
DJANGO_DEBUG=true
# Generate your own: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=replace-with-a-new-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CSRF_TRUSTED_ORIGINS=
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Production: DJANGO_DEBUG=false, exact public hosts, HTTPS, and a unique secret.
# Set this only behind a proxy that strips incoming X-Forwarded-Proto and sets its own.
DJANGO_TRUST_PROXY=false
DJANGO_HSTS_SECONDS=0
DJANGO_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_HSTS_PRELOAD=false
GROQ_TIMEOUT_SECONDS=20
CHAT_REQUESTS_PER_MINUTE=10
CHAT_REQUESTS_PER_DAY=100
ROADMAP_REQUESTS_PER_DAY=10
# Explicit experimental opt-in after reviewing docs/phase2c-recommendations.md.
RECOMMENDATION_ENGINE=legacy
RECOMMENDATION_SEMANTIC_ENABLED=false
# Record an immutable local embedding model revision when enabling semantic proposals.
RECOMMENDATION_MODEL_REVISION=unrecorded
# Private originals: never configure the web server to serve this directory.
PRIVATE_RESUME_ROOT=private_storage/resumes
